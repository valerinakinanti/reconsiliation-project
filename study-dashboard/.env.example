# Copy this file to .env and fill in your Supabase project's credentials.
# Find these under Project Settings -> API in the Supabase dashboard.
# The anon key is safe to expose in a client-side app (it's constrained by
# the Row Level Security policies in supabase/schema.sql) but should still
# live here, not hardcoded in source.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
